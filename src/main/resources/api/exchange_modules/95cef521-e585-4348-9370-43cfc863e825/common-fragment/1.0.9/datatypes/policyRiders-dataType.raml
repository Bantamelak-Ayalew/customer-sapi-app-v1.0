#%RAML 1.0 DataType
type: array
items:
  type: object
  properties:
    policyNumber:
      required: true 
      type: string
      example: "303-3966783"
    planCode:
      required: true 
      type: string
      example: "HMI10S"
    policyCategory:
      required: true 
      type: string
      example: "GROUP_HEALTH_PRODUCT"     
    planName:
      required: true 
      type: !include planName-dataType.raml
      example:
        en: "HEALTHPRO MAJOR ILLNESS INSURANCE -10"
        zh:  "康逸嚴重疾病保障 - 10"
    riderPlanEffectiveDate:
      required: true 
      type: string
      example: "20100224"
    riderPlanTerminationDate:
      required: true 
      type: string
      example: "99991231"
    documentCategory:
      required: true 
      type: string
      example: ""    
    hospitlCategory:
      required: true 
      type: string
      example: ""   
    planStatus:
      required: true 
      type: string
      example: ""   


        
        
        
    
    
    






    
  


