#%RAML 1.0 DataType
type: object
properties:
    emailAddress:
      required: true 
      type: string
      example: "TESTCUST@CON.COM"
    emailUpdateStatus:
      required: true 
      type: string
      example: "P"
    mobileNumber:
      required: true 
      type: string
      example: "12345678"
    mobileNumberUpdateStatus:
      required: true 
      type: string
      example: "S"
    address:
      type: object
      properties:
        addrLine1:
          required: true 
          type: string
          example: "JHH W 2/J ORE 2"          
        addrLine2:
          required: true 
          type: string
          example: "Villa Oasis Block J"    
        addrLine3:
          required: true 
          type: string
          example: "San Sik Road"    
        addrLine4:
          required: true 
          type: string
          example: "Wan Chai HK"    
    address_zh:
      required: true 
      type: string | nil
      example: ""
    addressUpdateStatus:
      required: true 
      type: string
      example: "s"







